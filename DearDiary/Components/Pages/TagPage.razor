@page "/tag/{TagName}"

@inject TagService TagService
@inject JournalService JournalService
@inject NavigationManager Nav

<h3 class="mb-4">#@TagName</h3>

@if (Journals.Count == 0)
{
    <p class="muted">No journals for this tag.</p>
}
else
{
    @foreach (var j in Journals)
    {
        <div class="card mb-4">
            <div class="card-body">

                <h5>@j.Title</h5>

                <p class="text-muted">
                    @j.EntryDate.ToString("dd MMM yyyy")
                </p>

                <!-- ✅ RENDER QUILL CONTENT PROPERLY -->
                <div class="journal-content">
                    @((MarkupString)j.Content)
                </div>

                <div class="mt-3">
                    <button class="btn btn-sm btn-outline-primary me-2"
                            @onclick="() => Edit(j.EntryDate)">
                        ✏️ Edit
                    </button>

                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="() => Delete(j.Id)">
                        🗑 Delete
                    </button>
                </div>

            </div>
        </div>
    }
}

@code {

    [Parameter]
    public string TagName { get; set; } = "";

    List<Journal> Journals = new();

    protected override async Task OnParametersSetAsync()
    {
        Journals = await TagService.GetByTagAsync(TagName);
    }

    void Edit(DateTime date)
    {
        Nav.NavigateTo($"/add/{date:yyyy-MM-dd}");
    }

    async Task Delete(int id)
    {
        await JournalService.DeleteAsync(id);
        Journals = await TagService.GetByTagAsync(TagName);
    }
}
