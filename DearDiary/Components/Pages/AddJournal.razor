@page "/add"
@page "/add/{date}"

@inject JournalService JournalService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>@(IsEdit ? "✏️ Edit Journal" : "➕ Add Journal")</h3>

<div class="card p-4">

    <input class="form-control mb-3"
           placeholder="Journal title"
           @bind="Entry.Title" />

    <!-- Rich Text Editor -->
    <div id="editor" style="height:220px;" class="mb-4"></div>

    <div class="mt-4">
        <button class="btn btn-dark me-2" @onclick="Save">
            Save Journal
        </button>

        <button class="btn btn-outline-secondary"
                @onclick="@(() => Nav.NavigateTo("/journals"))">
            Cancel
        </button>
    </div>
</div>

@code {

    // 🔑 ROUTE PARAM AS STRING
    [Parameter]
    public string? Date { get; set; }

    bool IsEdit => !string.IsNullOrWhiteSpace(Date);

    Journal Entry = new();

    bool quillInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        // ✏️ EDIT MODE
        if (IsEdit && DateTime.TryParse(Date, out var parsedDate))
        {
            var journal = await JournalService.GetByDateAsync(parsedDate.Date);

            if (journal != null)
            {
                Entry = new Journal
                {
                    Id = journal.Id,
                    EntryDate = journal.EntryDate, // ✅ ALWAYS VALID
                    Title = journal.Title,
                    Content = journal.Content,
                    PrimaryMood = journal.PrimaryMood,
                    SecondaryMood = journal.SecondaryMood,
                    Tags = journal.Tags,
                    CreatedAt = journal.CreatedAt,
                    UpdatedAt = journal.UpdatedAt
                };
            }

            return; // ⛔ STOP HERE
        }

        // ➕ ADD MODE
        var exists = await JournalService.ExistsForDateAsync(DateTime.Today);

        if (exists)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "You have already written a journal for today."
            );

            // 🚫 Do NOT allow add or edit
            Nav.NavigateTo("/journals");
            return; // ⛔ STOP EVERYTHING
        }



        // ✅ GUARANTEED DATE SET
        Entry.EntryDate = DateTime.Today;
        Entry.CreatedAt = DateTime.Now;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!quillInitialized)
        {
            quillInitialized = true;

            await JS.InvokeVoidAsync(
                "createQuill",
                "editor",
                Entry.Content
            );
        }
    }

    async Task Save()
    {
        Entry.Content = await JS.InvokeAsync<string>("getQuillContent");

        await JournalService.SaveAsync(Entry);

        // ✅ CORRECT PAGE
        Nav.NavigateTo("/journals");
    }
}
