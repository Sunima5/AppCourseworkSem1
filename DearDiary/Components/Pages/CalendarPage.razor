@page "/calendar"

@inject JournalService JournalService
@inject NavigationManager Nav

<h3>📅 Calendar</h3>

<Calendar OnDateSelected="LoadJournal"
          JournalDates="JournalDates" />

@if (SelectedJournal != null)
{
    <div class="card mt-4">
        <div class="card-body">

            <h5>@SelectedJournal.Title</h5>

            <p class="text-muted">
                @SelectedJournal.EntryDate.ToString("dd MMM yyyy")
            </p>

            <!-- ✅ RICH TEXT / HTML RENDER -->
            <div class="journal-content">
                @((MarkupString)SelectedJournal.Content)
            </div>

            <div class="mt-3">
                <button class="btn btn-sm btn-outline-primary me-2"
                        @onclick="Edit">
                    ✏️ Edit
                </button>

                <button class="btn btn-sm btn-outline-danger"
                        @onclick="Delete">
                    🗑 Delete
                </button>
            </div>

        </div>
    </div>
}
else if (SelectedDate != null)
{
    <p class="text-muted mt-3">
        No journal for this date.
    </p>
}

@code {

    List<DateTime> JournalDates = new();

    Journal? SelectedJournal;
    DateTime? SelectedDate;

    protected override async Task OnInitializedAsync()
    {
        var all = await JournalService.GetAllAsync();
        JournalDates = all.Select(j => j.EntryDate.Date).ToList();
    }

    async Task LoadJournal(DateTime date)
    {
        SelectedDate = date;
        SelectedJournal = await JournalService.GetByDateAsync(date);
    }

    // 📅 EDIT BY DATE (ROUTE-BASED)
    void Edit()
    {
        if (SelectedJournal != null)
        {
            Nav.NavigateTo($"/add/{SelectedJournal.EntryDate:yyyy-MM-dd}");
        }
    }

    // 🗑 DELETE BY ID (SERVICE EXPECTS INT)
    async Task Delete()
    {
        if (SelectedJournal == null) return;

        await JournalService.DeleteAsync(SelectedJournal.Id);

        JournalDates.Remove(SelectedJournal.EntryDate.Date);

        SelectedJournal = null;
        SelectedDate = null;
    }
}
