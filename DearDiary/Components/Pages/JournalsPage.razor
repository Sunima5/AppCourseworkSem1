@page "/journals"

@inject JournalService JournalService
@inject NavigationManager Nav

<h3>📖 All Journals</h3>

@if (!Journals.Any())
{
    <p class="text-muted">No journals yet.</p>
}
else
{
    <div class="journals-grid">
        @foreach (var j in Journals)
        {
            <div class="journal-box">
                <h5>@j.Title</h5>
                <p class="muted">@j.EntryDate.ToString("dd MMM yyyy")</p>

                <div class="preview">
                    @((MarkupString)(
                                j.Content.Length > 120
                                ? j.Content[..120] + "..."
                                : j.Content
                                ))
        </div>

                <div class="actions">
                    <!-- 🔥 EDIT BY DATE -->
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="() => Edit(j.EntryDate)">
                        Edit
                    </button>

                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="() => Delete(j.Id)">
                        Delete
                    </button>
                </div>
            </div>
        }
    </div>
}

<button class="btn btn-success mt-3" @onclick="AddNew">
    ➕ Add Journal
</button>

@code {

    List<Journal> Journals = new();

    protected override async Task OnInitializedAsync()
    {
        Journals = await JournalService.GetAllAsync();
    }

    void AddNew()
        => Nav.NavigateTo("/add");

    // 📅 Navigate using EntryDate (CORE FIX)
    void Edit(DateTime date)
        => Nav.NavigateTo($"/add/{date:yyyy-MM-dd}");

    async Task Delete(int id)
    {
        await JournalService.DeleteAsync(id);
        Journals = await JournalService.GetAllAsync();
    }
}
