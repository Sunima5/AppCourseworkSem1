@page "/journals"

@inject JournalService JournalService
@inject NavigationManager Nav

<h3>📖 All Journals</h3>

<!-- 🔝 TOP SEARCH + FILTER + DOWNLOAD BAR -->
<div class="top-bar">
    <input type="text"
           placeholder="🔍 Search journals..."
           @bind="searchText"
           @bind:event="oninput"
           class="search-bar" />

    <button class="filter-btn" @onclick="ToggleFilter">
        Filter
    </button>
</div>

<!-- 📅 FILTER PANEL -->
@if (showFilter)
{
    <div class="filter-panel">
        <input type="date" @bind="selectedDate" />
    </div>
}

@if (!FilteredJournals.Any())
{
    <p class="text-muted">No journals found.</p>
}
else
{
    <div class="journals-list">
        @foreach (var j in FilteredJournals)
        {
            <div class="journal-box">
                <h5>@j.Title</h5>

                <!-- 📅 DATE + 😊 PRIMARY MOOD -->
                <p class="muted journal-meta">
                    <span>@j.EntryDate.ToString("dd MMM yyyy")</span>

                    @if (!string.IsNullOrWhiteSpace(j.PrimaryMood))
                    {
                        <span class="mood-badge @GetMoodClass(j.PrimaryMood)">
                            @GetMoodEmoji(j.PrimaryMood) @j.PrimaryMood
                        </span>
                    }
            </p>

            <div class="preview">
                @((MarkupString)(
                            j.Content.Length > 120
                            ? j.Content[..120] + "..."
                            : j.Content
                            ))
        </div>

                <div class="actions">
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="() => Edit(j.EntryDate)">
                        Edit
                    </button>

                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="() => Delete(j.Id)">
                        Delete
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {

    List<Journal> Journals = new();

    string searchText = "";
    DateTime? selectedDate = null;
    bool showFilter = false;

    // 🔍 SEARCH + 📅 DATE FILTER
    List<Journal> FilteredJournals =>
        Journals.Where(j =>
            (string.IsNullOrWhiteSpace(searchText) ||
             j.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            &&
            (!selectedDate.HasValue ||
             j.EntryDate.Date == selectedDate.Value.Date)
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        Journals = await JournalService.GetAllAsync();
    }

    void ToggleFilter()
    {
        showFilter = !showFilter;
    }

    void Edit(DateTime date)
        => Nav.NavigateTo($"/add/{date:yyyy-MM-dd}");

    async Task Delete(int id)
    {
        await JournalService.DeleteAsync(id);
        Journals = await JournalService.GetAllAsync();
    }

    // 😊 MOOD HELPERS
    string GetMoodEmoji(string mood) => mood switch
    {
        "Positive" => "😊",
        "Neutral" => "😐",
        "Negative" => "😔",
        _ => "🙂"
    };

    string GetMoodClass(string mood) => mood switch
    {
        "Positive" => "mood-positive",
        "Neutral" => "mood-neutral",
        "Negative" => "mood-negative",
        _ => ""
    };
}
