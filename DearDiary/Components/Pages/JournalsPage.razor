@page "/journals"
@inject JournalService JournalService
@inject NavigationManager Nav
@inject PdfExportService PdfExportService

<h3>📖 All Journals</h3>

<!-- 🔍 SEARCH BAR -->
<div class="top-bar">
    <input type="text"
           placeholder="🔍 Search journals..."
           @bind="searchText"
           class="search-bar" />

    <input type="date"
           @bind="selectedDate"
           class="date-input" />

    <!-- 😊 MOOD FILTER -->
    <select class="mood-select" @bind="selectedMood">
        <option value="">😊 All Moods</option>
        <option value="Positive">😊 Positive</option>
        <option value="Neutral">😐 Neutral</option>
        <option value="Negative">😔 Negative</option>
    </select>

    <button class="search-btn" @onclick="ApplySearch">
        🔍 Search
    </button>

    <button class="search-btn" @onclick="ExportPdf">
        📄 Export PDF
    </button>
</div>

@if (PagedJournals.Any())
{
    <div class="journals-list">
        @foreach (var j in PagedJournals)
        {
            <div class="journal-box">
                <h5>@j.Title</h5>

                <p class="muted journal-meta">
                    <span>@j.EntryDate.ToString("dd MMM yyyy")</span>

                    @if (!string.IsNullOrWhiteSpace(j.PrimaryMood))
                    {
                        <span class="mood-badge @GetMoodClass(j.PrimaryMood)">
                            @GetMoodEmoji(j.PrimaryMood) @j.PrimaryMood
                        </span>
                    }
            </p>

            <div class="preview">
                @((MarkupString)(
                            j.Content.Length > 120
                            ? j.Content[..120] + "..."
                            : j.Content
                            ))
        </div>

                <div class="actions">
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="() => Edit(j.EntryDate)">
                        Edit
                    </button>

                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="() => Delete(j.Id)">
                        Delete
                    </button>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="no-journals">
        📭 No journals found.
    </div>
}

<!-- 🔢 PAGINATION -->
<div class="pagination-container">
    <button class="btn btn-outline-secondary"
            disabled="@IsFirstPage"
            @onclick="PreviousPage">
        ⬅ Previous
    </button>

    <span class="page-info">
        Page @CurrentPage of @TotalPages
    </span>

    <button class="btn btn-outline-secondary"
            disabled="@IsLastPage"
            @onclick="NextPage">
        Next ➡
    </button>
</div>

@code {
    List<Journal> Journals = new();
    List<Journal> PagedJournals = new();

    // 🔍 Input values
    string searchText = "";
    DateTime? selectedDate = null;
    string selectedMood = "";

    // ✅ Applied filters
    string appliedSearchText = "";
    DateTime? appliedDate = null;
    string appliedMood = "";

    int PageSize = 3;
    int CurrentPage = 1;

    // 🔎 FILTER LOGIC (TEXT + DATE + MOOD)
    List<Journal> FilteredJournals =>
        Journals
            .Where(j =>
                (string.IsNullOrWhiteSpace(appliedSearchText) ||
                 j.Title.Contains(appliedSearchText, StringComparison.OrdinalIgnoreCase) ||
                 j.Content.Contains(appliedSearchText, StringComparison.OrdinalIgnoreCase))
                &&
                (!appliedDate.HasValue ||
                 j.EntryDate.Date == appliedDate.Value.Date)
                &&
                (string.IsNullOrWhiteSpace(appliedMood) ||
                 j.PrimaryMood == appliedMood)
            )
            .OrderByDescending(j => j.EntryDate)
            .ToList();

    int TotalPages =>
        Math.Max(1, (int)Math.Ceiling((double)FilteredJournals.Count / PageSize));

    bool IsFirstPage => CurrentPage == 1;
    bool IsLastPage => CurrentPage == TotalPages;

    protected override async Task OnInitializedAsync()
    {
        Journals = await JournalService.GetAllAsync();
        UpdatePage();
    }

    void ApplySearch()
    {
        appliedSearchText = searchText;
        appliedDate = selectedDate;
        appliedMood = selectedMood;

        CurrentPage = 1;
        UpdatePage();
    }

    void UpdatePage()
    {
        if (CurrentPage > TotalPages)
            CurrentPage = TotalPages;

        PagedJournals = FilteredJournals
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    // 📄 PDF EXPORT (exports filtered data)
    async Task ExportPdf()
    {
        try
        {
            var journalsToExport = FilteredJournals;

            if (!journalsToExport.Any())
            {
                await Application.Current.MainPage.DisplayAlert(
                    "No Data",
                    "There are no journals to export.",
                    "OK"
                );
                return;
            }

            var pdfBytes = PdfExportService.GenerateJournalPdf(journalsToExport);

            var fileName = $"DearDiary_Journals_{DateTime.Now:yyyy-MM-dd}.pdf";

            var path = Path.Combine(
                FileSystem.AppDataDirectory,
                fileName
            );

            File.WriteAllBytes(path, pdfBytes);

            await Launcher.OpenAsync(new OpenFileRequest
            {
                File = new ReadOnlyFile(path)
            });
        }
        catch (Exception ex)
        {
            await Application.Current.MainPage.DisplayAlert(
                "PDF Error ❌",
                ex.Message,
                "OK"
            );
        }
    }

    void NextPage()
    {
        if (!IsLastPage)
        {
            CurrentPage++;
            UpdatePage();
        }
    }

    void PreviousPage()
    {
        if (!IsFirstPage)
        {
            CurrentPage--;
            UpdatePage();
        }
    }

    void Edit(DateTime date)
        => Nav.NavigateTo($"/add/{date:yyyy-MM-dd}");

    async Task Delete(int id)
    {
        await JournalService.DeleteAsync(id);
        Journals = await JournalService.GetAllAsync();
        UpdatePage();
    }

    // 😊 MOOD HELPERS
    string GetMoodEmoji(string mood) => mood switch
    {
        "Positive" => "😊",
        "Neutral" => "😐",
        "Negative" => "😔",
        _ => "🙂"
    };

    string GetMoodClass(string mood) => mood switch
    {
        "Positive" => "mood-positive",
        "Neutral" => "mood-neutral",
        "Negative" => "mood-negative",
        _ => ""
    };
}